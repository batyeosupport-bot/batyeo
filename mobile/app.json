{
  "expo": {
    "name": "BATYEO",
    "slug": "batyeo",
    "version": "0.1.0",
    "scheme": "batyeo",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#19382c"
    },
    "ios": {
      "bundleIdentifier": "com.batyeo.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "BATYEO utilise la caméra pour scanner les QR codes des stations.",
        "NSLocationWhenInUseUsageDescription": "BATYEO utilise votre position pour afficher les stations proches."
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.batyeo.mobile",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION"
      ],
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#19382c"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser BATYEO à scanner les QR codes des stations.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Votre position permet de classer les stations proches. Vous pouvez aussi utiliser la liste sans GPS."
        }
      ],
      "./plugins/withFmtConstevalFix.js",
      "expo-asset"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
