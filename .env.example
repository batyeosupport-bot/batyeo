# Hosted demo: D1 binding DB is supplied by Sites. No payment or hardware credentials.
# Future PostgreSQL adapter (not connected by the hosted D1 runtime):
DATABASE_URL="postgresql://batyeo:change-me@localhost:5432/batyeo?schema=public"
# Direct (non-pooled) connection used only for `prisma migrate`. On Supabase, use the
# session pooler or db.<project-ref>.supabase.co:5432 — the transaction pooler (:6543)
# does not support the prepared statements Prisma Migrate needs.
DIRECT_DATABASE_URL="postgresql://batyeo:change-me@localhost:5432/batyeo?schema=public"
# Stripe TEST only; never commit real credentials. The webhook endpoint fails closed when absent.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
PAYMENT_PROVIDER="mock" # mock | stripe_test
BATYEO_PAYMENT_PROVIDER="mock" # legacy alias; PAYMENT_PROVIDER wins
# Bajie / ChargeNow READ-ONLY. Set provider to bajie only when all credentials exist.
MANUFACTURER_PROVIDER="disabled" # disabled | bajie
MANUFACTURER_API_BASE_URL="https://developer.chargenow.top/cdb-open-api/v1"
MANUFACTURER_USERNAME=""
MANUFACTURER_PASSWORD=""
# Real battery ejections on real hardware. Only 'true' or 'false' are accepted — any other value
# fails closed at startup. 'true' additionally requires MANUFACTURER_PROVIDER=bajie and
# PAYMENT_PROVIDER=stripe_test: the mock payment path ejects synchronously through the simulator
# and cannot drive a real cabinet, so that combination is refused rather than silently faked.
# Leave false until the manufacturer's own native rental flow is disabled on the account —
# otherwise both systems can dispense the same battery. See docs/EXTERNAL_BLOCKERS.md.
MANUFACTURER_ALLOW_PHYSICAL_ACTIONS="false"
MANUFACTURER_SYNC_SECRET=""
# Bearer secret for the internal job that captures overdue deposits as a definitive loss
# (battery never returned after 48h) — POST internal/rentals/capture-overdue-losses.
OVERDUE_CAPTURE_SECRET=""
# Demo accounts are seeded only with synthetic data. Replace demo provisioning before commercial use.
