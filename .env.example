# Hosted demo: D1 binding DB is supplied by Sites. No payment or hardware credentials.
# Future PostgreSQL adapter (not connected by the hosted D1 runtime):
DATABASE_URL="postgresql://batyeo:change-me@localhost:5432/batyeo?schema=public"
# Stripe TEST only; never commit real credentials. The webhook endpoint fails closed when absent.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
PAYMENT_PROVIDER="mock" # mock | stripe_test
BATYEO_PAYMENT_PROVIDER="mock" # legacy alias; PAYMENT_PROVIDER wins
# Bajie / ChargeNow READ-ONLY. Set provider to bajie only when all credentials exist.
MANUFACTURER_PROVIDER="disabled" # disabled | bajie
MANUFACTURER_API_BASE_URL="https://developer.chargenow.top/cdb-open-api/v1"
MANUFACTURER_USERNAME=""
MANUFACTURER_PASSWORD=""
MANUFACTURER_ALLOW_PHYSICAL_ACTIONS="false"
MANUFACTURER_SYNC_SECRET=""
# Demo accounts are seeded only with synthetic data. Replace demo provisioning before commercial use.
