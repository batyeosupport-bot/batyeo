{
  "name": "batyeo-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .test-build --ignore-pattern mobile",
    "db:generate": "drizzle-kit generate",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "test:integration": "node scripts/integration.mjs",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "node --import tsx scripts/postgres/migrate.ts",
    "db:seed:demo": "node --import tsx scripts/postgres/seed.ts",
    "db:bootstrap": "node --import tsx scripts/postgres/bootstrap.ts",
    "test:postgres": "node --import tsx --test tests/postgres.integration.ts",
    "manufacturer:check": "node --import tsx scripts/manufacturer-readonly-check.ts",
    "staging:doctor": "node --import tsx scripts/staging-doctor.ts",
    "hardware:doctor": "node --import tsx scripts/hardware-doctor.ts",
    "hardware:acceptance": "node --import tsx scripts/first-station-acceptance.ts",
    "db:doctor": "node --import tsx scripts/db-doctor.ts",
    "staging:bootstrap": "node --import tsx scripts/staging-bootstrap.ts",
    "staging:golden-flow": "node --import tsx scripts/staging-golden-flow.ts",
    "staging:failure-matrix": "node --import tsx scripts/staging-failure-matrix.ts",
    "release:readiness": "node --import tsx scripts/release-readiness.ts",
    "release:readiness:json": "READINESS_JSON=true node --import tsx scripts/release-readiness.ts",
    "release:readiness:strict": "READINESS_JSON=true READINESS_STRICT=true node --import tsx scripts/release-readiness.ts",
    "test:sql": "node --import tsx --test tests/sql.test.ts",
    "build:postgres": "next build --webpack",
    "start:postgres": "next start",
    "dev:postgres": "next dev --webpack"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "6.19.0",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "pg": "8.16.3",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@electric-sql/pglite": "0.3.14",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prisma": "6.19.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
